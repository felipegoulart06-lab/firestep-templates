# Origem pública do site (sitemap, canonical, Open Graph)
SITE_ORIGIN=https://templates.firestep.cloud

# Supabase (anon/public — nunca coloque SERVICE_ROLE aqui)
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=

# Webhooks Make (opcional)
TEMPLATE_WEBHOOK=
BRIEFING_WEBHOOK=
INTEREST_WEBHOOK=

# FirestepCRM (formulário Tenho interesse → POST JSON)
FIRESTEP_CRM_WEBHOOK_URL=
FIRESTEP_CRM_WEBHOOK_SECRET=

# WhatsApp do atendimento (somente dígitos, com DDI)
SUPPORT_WHATSAPP=

# Cloudflare R2 (mídia dos templates — não use o Storage do Supabase)
R2_ACCOUNT_ID=97ffef1ae71def38ec8915c7c530fbd8
R2_BUCKET=templates
R2_ENDPOINT=https://97ffef1ae71def38ec8915c7c530fbd8.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Opcional: URL pública do bucket (r2.dev ou domínio custom). Sem isso, as imagens saem por /api/r2
R2_PUBLIC_BASE_URL=https://pub-6d8a03f8914549f797582ff9419e9250.r2.dev

# API local de publicação (não usar em produção)
PUBLISH_API=http://127.0.0.1:8787
PORT=8787
